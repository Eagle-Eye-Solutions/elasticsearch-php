{
  "name": "eagle-eye-solutions/elasticsearch",
  "description": "PHP Client for Elasticsearch",
  "keywords": [
    "search",
    "client",
    "elasticsearch"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Zachary Tong"
    }
  ],
  "require": {
    "php": "^8.2",
    "psr/log": "~1.0",
    "ezimuel/ringphp": "^1.4.1",
    "react/promise": "^3.2"
  },
  "require-dev": {
    "phpunit/phpunit": "~4.7",
    "mockery/mockery": "0.9.4",
    "symfony/yaml": "2.4.3 as 2.4.2",
    "twig/twig": "1.*",
    "cpliakas/git-wrapper": "~1.0",
    "sami/sami": "~3.2",
    "rector/rector": "^0.18.6"
  },
  "suggest": {
    "ext-curl": "*",
    "monolog/monolog": "Allows for client-level logging and tracing"
  },
  "replace": {
    "elasticsearch/elasticsearch": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Elasticsearch\\": "src/Elasticsearch/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Elasticsearch\\Tests\\": "tests/Elasticsearch/Tests/"
    }
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/polyfractal/Yaml"
    },
    {
      "type": "composer",
      "url": "https://repo.packagist.com/eagle-eye-solutions/"
    },
    {
      "packagist.org": false
    }
  ],
  "config": {
    "audit": {
      "ignore": {
        "phpunit/phpunit": {
          "apply": "block",
          "reason": "Dev only. The test suite still targets PHPUnit 4"
        },
        "symfony/process": {
          "apply": "block",
          "reason": "Dev only. Required by sami for docs generation"
        },
        "symfony/yaml": {
          "apply": "block",
          "reason": "Dev only. Used by the REST spec runner in util/"
        },
        "twig/twig": {
          "apply": "block",
          "reason": "Dev only. Used by sami for docs generation"
        }
      }
    }
  }
}
